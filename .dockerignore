# Both source builds and release packaging use this repository as their context.
# Allow only Go source, required runtime web resources and packaged public binaries.
**
!go.mod
!go.sum
# One line per directory that holds Go source. Podman (Buildah) and the classic
# Docker builder skip an excluded directory unless an exception below starts
# with that directory's literal path, so "!src/**/*.go" reaches no package
# directory there. BuildKit does not need the literal path, but the same lines
# give it the same result. Add a line when a new package directory is added.
!src/cmd/stargate/*.go
!src/internal/auditlog/*.go
!src/internal/auth/*.go
!src/internal/config/*.go
!src/internal/doctor/*.go
!src/internal/handlers/*.go
!src/internal/i18n/*.go
!src/internal/metrics/*.go
!src/internal/requestcontext/*.go
!src/internal/tlsconfig/*.go
!src/internal/tracing/*.go
!src/internal/web/*.go
!src/internal/web/templates/login.html
!src/internal/web/templates/login.warden.html
!src/internal/web/templates/account.html
!src/internal/web/templates/totp_start.html
!src/internal/web/templates/totp_enroll.html
!src/internal/web/templates/totp_revoke.html
!src/internal/web/templates/step_up.html
!src/internal/web/templates/assets/auth-ui.js
!src/internal/web/templates/assets/auth-ui.css
!src/internal/web/templates/assets/qrcode.min.js
!src/internal/web/templates/assets/favicon.ico
!dist/stargate-linux-amd64
!dist/stargate-linux-arm64
# Late denies also protect generated files placed under otherwise allowed paths.
**/*_test.go
**/.env*
**/audit-spool
**/audit-spool/**
**/generated-output*
**/generated-output*/**
**/outputs
**/outputs/**
**/__pycache__
**/__pycache__/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
